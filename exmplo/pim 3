def selecionar_arquivo(caminho=None):
    global caminho_arquivo_atual, dados_alunos
    if caminho is None:
        caminho = filedialog.askopenfilename(
            title="Selecione o arquivo CSV de alunos",
            initialdir=CREDENTIALS_DIR,
            filetypes=[("Arquivos CSV", "*.csv"), ("Todos os arquivos", "*.*")]
        )
    if not caminho and os.path.exists(DEFAULT_CSV_FILE_PATH):
        caminho = DEFAULT_CSV_FILE_PATH
    elif not caminho:
        return

    caminho_arquivo_atual = caminho
    linhas = ler_linhas_csv(caminho)
    if not linhas:
        mostrar_todos_alunos()
        return

    dados_validos = []
    for i, linha in enumerate(linhas[1:], start=1):
        if not linha: continue
        
        # Compatibilidade com arquivos antigos que possuem menos colunas
        if len(linha) < NUM_COLUNAS_ESPERADAS:
            nome = linha[0] if len(linha) > 0 else ""
            ra = linha[1] if len(linha) > 1 else ""
            email = linha[2] if len(linha) > 2 else ""
            nome_social = ""
            etnia = "Não informado"
            notas = linha[3:] if len(linha) > 3 else ["0.00"] * len(LISTA_DISCIPLINAS)
            linha_proc = [nome, nome_social, ra, email, etnia] + notas
        else:
            linha_proc = linha[:NUM_COLUNAS_ESPERADAS]

        while len(linha_proc) < NUM_COLUNAS_ESPERADAS:
            linha_proc.append("0.00")

        _recalcular_media_geral(linha_proc)
        dados_validos.append(linha_proc)

    dados_alunos = dados_validos
    mostrar_todos_alunos()

def lancar_nota():
    if nivel_acesso_atual not in ["Admin", "Professores"]:
        messagebox.showwarning("Acesso Negado", "Apenas Administradores e Professores podem lançar notas.")
        return
    if not dados_alunos:
        messagebox.showwarning("Aviso", "Nenhum aluno carregado.")
        return

    coluna_indice = None
    disciplina_nome_display = None

    if nivel_acesso_atual == "Admin":
        prompt_disciplinas = ", ".join([DISPLAY_NAMES.get(d, d) for d in LISTA_DISCIPLINAS])
        escolha = simpledialog.askstring("Admin: Selecionar Disciplina", f"Digite a disciplina ({prompt_disciplinas}):", parent=janela)
        if not escolha: return
        chave = escolha.strip().lower()
        for internal in LISTA_DISCIPLINAS:
            if DISPLAY_NAMES.get(internal, internal).lower() == chave or internal.lower() == chave:
                coluna_indice = COLUNA_MAP[internal]
                disciplina_nome_display = DISPLAY_NAMES.get(internal, internal)
                break
        if coluna_indice is None:
            messagebox.showerror("Erro", "Disciplina não encontrada.")
            return
    else:
        disciplina_interna = PROFESSOR_TO_COLNAME.get(usuario_logado, None)
        coluna_indice = COLUNA_MAP.get(disciplina_interna, None)
        disciplina_nome_display = DISPLAY_NAMES.get(disciplina_interna, disciplina_interna)

    num = simpledialog.askinteger("Lançar Nota", f"Selecione o número do aluno (1 a {len(dados_alunos)}):", parent=janela, minvalue=1, maxvalue=len(dados_alunos))
    if num is None: return
    indice_aluno = num - 1
    aluno_selecionado = dados_alunos[indice_aluno]

    # Prioriza Exibição do Nome Social se existir
    nome_exibicao = aluno_selecionado[1] if aluno_selecionado[1].strip() else aluno_selecionado[0]

    nova_nota_str = simpledialog.askstring("Lançar Nota", f"Nova nota para {nome_exibicao} em {disciplina_nome_display}:", parent=janela)
    if nova_nota_str is None: return
    try:
        nova_nota = float(nova_nota_str.replace(',', '.'))
        if not (0.0 <= nova_nota <= 10.0): raise ValueError()
    except ValueError:
        messagebox.showerror("Erro", "A nota deve ser um número entre 0.0 e 10.0.")
        return

    aluno_modificado = list(aluno_selecionado)
    aluno_modificado[coluna_indice] = f"{nova_nota:.2f}"
    _recalcular_media_geral(aluno_modificado)

    dados_alunos[indice_aluno] = aluno_modificado
    if caminho_arquivo_atual:
        linhas = ler_linhas_csv(caminho_arquivo_atual)
        if linhas:
            cabecalho = linhas.pop(0)
            if 0 <= indice_aluno < len(linhas):
                linhas[indice_aluno] = aluno_modificado
            salvar_linhas_csv(caminho_arquivo_atual, linhas, cabecalho)

    mostrar_todos_alunos()
    messagebox.showinfo("Sucesso", f"Nota de {nome_exibicao} atualizada para {nova_nota:.2f}.")

def mostrar_todos_alunos():
    if 'tree' not in globals() or tree is None: return
    for item in tree.get_children():
        tree.delete(item)

    alunos_a_exibir = dados_alunos
    if nivel_acesso_atual == "Alunos":
        usuario_aluno = usuario_logado
        alunos_a_exibir = []
        for aluno in dados_alunos:
            # Checa se login corresponde ao email/nome/nome_social
            login_aluno = aluno[3].split('@')[0].lower() if len(aluno) > 3 and '@' in aluno[3] else aluno[0].split()[0].lower()
            if login_aluno == usuario_aluno or aluno[0].split()[0].lower() == usuario_aluno:
                alunos_a_exibir.append(aluno)
                break

    colunas_visiveis_tree = ["#", "Nome Exibido", "Nome Social", "RA", "Email", "Etnia"]
    indices_dados_visiveis = [0, 1, 2, 3, 4] # Nome, Nome Social, RA, Email, Etnia
    
    for disc_interna in LISTA_DISCIPLINAS:
        if disc_interna != "Extra" or "Extra" in PROFESSORES_POR_DISCIPLINA:
            colunas_visiveis_tree.append(disc_interna)
            indices_dados_visiveis.append(COLUNA_MAP.get(disc_interna))

    colunas_visiveis_tree.append("Media Geral")
    indices_dados_visiveis.append(COLUNA_MAP.get("Media Geral"))
        
    tree["columns"] = colunas_visiveis_tree
    tree["show"] = "headings"

    for col_interna in colunas_visiveis_tree:
        display_text = DISPLAY_NAMES.get(col_interna, col_interna)
        tree.heading(col_interna, text=display_text)
        tree.column(col_interna, width=110, anchor=tk.CENTER if col_interna not in ["Nome Exibido", "Email"] else tk.W)

    for i, linha_completa in enumerate(alunos_a_exibir):
        # Seleção de Nome Exibido (Prioriza Nome Social)
        nome_civil = linha_completa[0] if len(linha_completa) > 0 else ""
        nome_soc = linha_completa[1] if len(linha_completa) > 1 else ""
        nome_prioritario = nome_soc if nome_soc.strip() else nome_civil

        dados_para_tree = [i + 1, nome_prioritario]
        
        # Adiciona Nome Social, RA, Email, Etnia, Disciplinas e Média Geral
        for idx in indices_dados_visiveis[1:]:
            if idx is not None and 0 <= idx < len(linha_completa):
                dados_para_tree.append(linha_completa[idx])
            else:
                dados_para_tree.append("N/A")

        if nivel_acesso_atual == "Professores":
            disciplina_prof = PROFESSOR_TO_COLNAME.get(usuario_logado, "")
            # Oculta notas de outras disciplinas para o professor
            col_idx_tree = 6 
            for disc_interna in LISTA_DISCIPLINAS:
                if disc_interna == "Extra" and "Extra" not in PROFESSORES_POR_DISCIPLINA: continue
                if disc_interna != disciplina_prof and col_idx_tree < len(dados_para_tree):
                    dados_para_tree[col_idx_tree] = "---"
                col_idx_tree += 1
            if col_idx_tree < len(dados_para_tree):
                dados_para_tree[col_idx_tree] = "---"

        tree.insert("", "end", values=dados_para_tree)

def obter_indice_aluno():
    if not dados_alunos: return None
    if nivel_acesso_atual == "Alunos":
        return 0 if len(dados_alunos) > 0 else None
    num = simpledialog.askinteger("Selecionar Aluno", f"Digite o número do aluno (1 a {len(dados_alunos)}):", parent=janela, minvalue=1, maxvalue=len(dados_alunos))
    return (num - 1) if num else None

def mostrar_notas():
    indice = obter_indice_aluno()
    if indice is None or not (0 <= indice < len(dados_alunos)): return

    aluno = dados_alunos[indice]
    nome_exibicao = aluno[1] if len(aluno) > 1 and aluno[1].strip() else aluno[0]

    janela_notas = tk.Toplevel(janela)
    janela_notas.title(f"Notas de {nome_exibicao}")
    janela_notas.geometry("450x320")

    texto = f"Aluno: {nome_exibicao}\nRA: {aluno[2]}\n\n"
    if nivel_acesso_atual == "Professores":
        disc_prof = PROFESSOR_TO_COLNAME.get(usuario_logado, None)
        col_idx = COLUNA_MAP.get(disc_prof)
        if disc_prof and col_idx < len(aluno):
            texto += f"{DISPLAY_NAMES.get(disc_prof, disc_prof)}: {aluno[col_idx]}\n"
    else:
        for disc_interna in LISTA_DISCIPLINAS:
            if disc_interna == "Extra" and "Extra" not in PROFESSORES_POR_DISCIPLINA: continue
            col_idx = COLUNA_MAP.get(disc_interna)
            texto += f"{DISPLAY_NAMES.get(disc_interna, disc_interna)}: {aluno[col_idx] if col_idx < len(aluno) else 'N/A'}\n"
        texto += f"\n============================\nMÉDIA GERAL: {aluno[COLUNA_MAP['Media Geral']]}\n"

    tk.Label(janela_notas, text=texto, font=("Arial", 11), justify=tk.LEFT, padx=20, pady=20).pack()

def gerar_grafico():
    indice = obter_indice_aluno()
    if indice is None or not (0 <= indice < len(dados_alunos)): return

    global canvas_grafico, botao_fechar_grafico
    if canvas_grafico: canvas_grafico.get_tk_widget().destroy()
    if botao_fechar_grafico: botao_fechar_grafico.destroy()

    aluno = dados_alunos[indice]
    nome_exibicao = aluno[1] if len(aluno) > 1 and aluno[1].strip() else aluno[0]

    disciplinas_finais = []
    medias_finais = []
    for disc_interna in LISTA_DISCIPLINAS:
        if disc_interna == "Extra" and "Extra" not in PROFESSORES_POR_DISCIPLINA: continue
        disciplinas_finais.append(DISPLAY_NAMES.get(disc_interna, disc_interna))
        col_idx = COLUNA_MAP.get(disc_interna)
        try: medias_finais.append(float(aluno[col_idx]))
        except: medias_finais.append(0.0)

    fig, ax = plt.subplots(figsize=(6,3.5))
    ax.bar(disciplinas_finais, medias_finais, color='#6A1B9A')
    ax.set_ylim(0, 10)
    ax.set_title(f'Desempenho Acadêmico - {nome_exibicao}')
    
    canvas_grafico = FigureCanvasTkAgg(fig, master=janela)
    canvas_grafico.draw()
    canvas_grafico.get_tk_widget().pack(pady=10, fill=tk.BOTH, expand=False)

    botao_fechar_grafico = tk.Button(janela, text="Fechar Gráfico", command=lambda: [canvas_grafico.get_tk_widget().destroy(), botao_fechar_grafico.destroy()], bg="red", fg="white")
    botao_fechar_grafico.pack(pady=5)

def mostrar_professores():
    janela_prof = tk.Toplevel(janela)
    janela_prof.title("Quadro de Professores")
    janela_prof.geometry("380x250")
    texto = "=== Corpo Docente por Disciplina ===\n\n"
    for disc_interna in LISTA_DISCIPLINAS:
        prof = PROFESSORES_POR_DISCIPLINA.get(disc_interna, "(Vago)")
        texto += f"{DISPLAY_NAMES.get(disc_interna, disc_interna)}: {prof.capitalize()}\n"
    tk.Label(janela_prof, text=texto, font=("Arial", 11), justify=tk.LEFT, padx=20, pady=20).pack()

def analisar_por_ia():
    if nivel_acesso_atual != "Alunos": return
    aluno = dados_alunos[0] if dados_alunos else None
    if not aluno: return

    nome_exibicao = aluno[1] if len(aluno) > 1 and aluno[1].strip() else aluno[0]
    media_geral = float(aluno[COLUNA_MAP["Media Geral"]])

    msg = f"Olá, {nome_exibicao}!\n\nSua média geral atual é {media_geral:.2f}.\n"
    if media_geral >= 7.0:
        msg += "Parabéns! Excelente desempenho acadêmico. Continue mantendo esse foco!"
    else:
        msg += "Atenção: Revise os tópicos das disciplinas com nota mais baixa para garantir sua aprovação."

    messagebox.showinfo("Análise de Progresso I.A.", msg, parent=janela)

# =================== CADASTROS E LOGIN ===================
def verificar_credenciais(usuario, senha):
    CREDENCIAIS["Alunos"] = carregar_credenciais_alunos()
    CREDENCIAIS["Professores"] = carregar_credenciais_professores()
    u_norm = usuario.strip().lower()

    for admin_u, admin_p in CREDENCIAIS.get("Admin", {}).items():
        if u_norm == admin_u.lower() and senha == admin_p: return "Admin"
    for prof_u, prof_p in CREDENCIAIS.get("Professores", {}).items():
        if u_norm == prof_u.lower() and senha == prof_p: return "Professores"
    for aluno_u, aluno_p in CREDENCIAIS.get("Alunos", {}).items():
        if u_norm == aluno_u.lower() and senha == aluno_p: return "Alunos"
    return None

def cadastrar_novo_aluno_interface(parent_window=None):
    if parent_window is None: parent_window = janela
    os.makedirs(CONFIDENTIAL_DATA_DIR, exist_ok=True)

    nome = simpledialog.askstring("Cadastro Aluno (1/5)", "Nome Civil Completo:", parent=parent_window)
    if not nome: return

    nome_social = simpledialog.askstring("Cadastro Aluno (2/5)", "Nome Social (Opcional - Pressione Enter se não houver):", parent=parent_window) or ""

    base_login = (nome_social if nome_social.strip() else nome).split()[0].lower()
    login = base_login
    creds_existentes = carregar_credenciais_alunos()
    suffix = 1
    while login in creds_existentes:
        login = f"{base_login}{suffix}"
        suffix += 1

    senha = simpledialog.askstring("Cadastro Aluno (3/5)", f"Crie uma Senha para o login '{login}':", show='*', parent=parent_window)
    if not senha: return

    ra = simpledialog.askstring("Cadastro Aluno (4/5)", "RA (Registro Acadêmico):", parent=parent_window)
    if not ra: return

    email_padrao = login + "@unip.com"
    email = simpledialog.askstring("Cadastro Aluno (5/5)", f"Email:", initialvalue=email_padrao, parent=parent_window) or email_padrao

    etnia = simpledialog.askstring("Autodeclaração Étnico-Racial", "Autodeclaração Étnico-Racial (Opcional):\nEx: Amarela, Branca, Indígena, Parda, Preta:", parent=parent_window) or "Não informado"

    notas_vazias = ["0.00"] * len(LISTA_DISCIPLINAS)
    nova_linha = [nome, nome_social, ra, email, etnia] + notas_vazias + ["0.00"]

    if salvar_dados_no_csv(DEFAULT_CSV_FILE_PATH, nova_linha) and salvar_credenciais_csv(login, senha):
        messagebox.showinfo("Sucesso", f"Aluno cadastrado!\nLogin: '{login}'\nNome de Exibição: '{nome_social if nome_social else nome}'", parent=parent_window)

def iniciar_cadastro_professor(parent_window=None):
    if parent_window is None: parent_window = janela
    senha_admin = simpledialog.askstring("Autenticação", "Digite a senha do 'admin':", show='*', parent=parent_window)
    if senha_admin == CREDENCIAIS["Admin"]["admin"]:
        cadastrar_novo_professor_interface(parent_window)

def cadastrar_novo_professor_interface(parent_window=None):
    if parent_window is None: parent_window = janela
    login = simpledialog.askstring("Cadastro Professor", "Login do Professor:", parent=parent_window)
    if not login: return
    login = login.strip().lower()

    senha = simpledialog.askstring("Cadastro Professor", "Senha:", show='*', parent=parent_window)
    if not senha: return

    disc_display = simpledialog.askstring("Cadastro Professor", f"Disciplina ({', '.join(LISTA_DISCIPLINAS)}):", parent=parent_window)
    if not disc_display: return

    disc_interna = disc_display.strip()
    if salvar_credenciais_professor_csv(login, senha) and salvar_mapeamento_professor_csv(login, disc_interna):
        carregar_dados_professores()
        messagebox.showinfo("Sucesso", f"Professor '{login}' cadastrado com sucesso!", parent=parent_window)

def tentar_login(user_entry, senha_entry):
    global nivel_acesso_atual, usuario_logado, login_frame_global
    u = user_entry.get().strip().lower()
    s = senha_entry.get().strip()
    nivel = verificar_credenciais(u, s)

    if nivel:
        nivel_acesso_atual = nivel
        usuario_logado = u
        if login_frame_global: login_frame_global.destroy()
        fechar_janela_imagem_fundo()

        construir_interface_principal()
        janela.geometry(geometria_principal)
        janela.title(f"Sistema Acadêmico - {nivel} ({u.capitalize()})")
        selecionar_arquivo(caminho=DEFAULT_CSV_FILE_PATH)
    else:
        messagebox.showerror("Erro", "Usuário ou senha inválidos.", parent=janela)

